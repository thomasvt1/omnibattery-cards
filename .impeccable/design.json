      "name": "Metric inspection",
      "kind": "button",
      "refersTo": "metric-button",
      "description": "Quiet sensor-detail action; example reading is synthetic.",
      "html": "<button class=\"ds-metric\">240 W</button>",
      "css": ".ds-metric{font:inherit;color:var(--primary-text-color,#202530);appearance:none;padding:0;border:0;background:transparent;text-align:inherit;border-radius:3px;cursor:pointer;font-variant-numeric:tabular-nums}.ds-metric:hover{color:var(--primary-color,#03a9f4)}.ds-metric:focus-visible{outline:2px solid var(--primary-color,#03a9f4);outline-offset:3px}.ds-metric:disabled{cursor:default;opacity:.65}"
    },
    {
      "name": "Time range",
      "kind": "nav",
      "description": "Plan range navigation with the shipped pressed and focus states; no separate hover declaration exists.",
      "html": "<div class=\"ds-range\" aria-label=\"Plan range\"><button aria-pressed=\"true\">Today</button><button aria-pressed=\"false\">Extended</button></div>",
      "css": ".ds-range{display:flex;gap:2px;padding:3px;background:var(--secondary-background-color,#f3f5f8);border-radius:8px;width:max-content}.ds-range button{font:inherit;color:var(--primary-text-color,#202530);cursor:pointer;border:0;background:transparent;padding:5px 9px;border-radius:5px;font-size:12px}.ds-range button[aria-pressed=true]{background:var(--ha-card-background,var(--card-background-color,#fff));color:var(--primary-color,#0288d1)}.ds-range button:focus-visible{outline:2px solid var(--primary-color,#03a9f4);outline-offset:3px}"
    },
