    {
      "name": "Status inspection row",
      "kind": "button",
      "description": "Text-led sensor status with a tinted inline SVG disc; example copy is synthetic.",
      "html": "<button class=\"ds-status\"><span class=\"ds-disc\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m7 12 3 3 7-7\"/></svg></span><span class=\"ds-copy\"><span class=\"ds-title\">Connected</span><span class=\"ds-detail\">Readings available</span></span></button>",
      "css": ".ds-status{display:flex;align-items:flex-start;gap:12px;width:100%;padding:11px 0;color:var(--primary-text-color,#17202c);text-align:left;font:inherit;border:0;border-radius:5px;background:transparent;cursor:pointer}.ds-status:hover .ds-title{text-decoration:underline;text-underline-offset:3px}.ds-status:focus-visible{outline:2px solid var(--primary-color,#03a9f4);outline-offset:3px}.ds-disc{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:50%;color:var(--energy-battery-out-color,#00a99a);background:color-mix(in srgb,var(--energy-battery-out-color,#00a99a) 10%,transparent)}.ds-disc svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-copy{display:flex;flex-direction:column;gap:2px;align-self:center;min-width:0;padding:1px 0}.ds-title{font-size:13px;line-height:1.5;overflow-wrap:anywhere}.ds-detail{font-size:12px;line-height:1.5;color:var(--secondary-text-color,#646b75);overflow-wrap:anywhere}"
    }
  ],
  "narrative": {
    "dos": [
      "**Do** inherit Home Assistant fonts, theme surfaces, energy colors, locale, and units.",
      "**Do** keep measured and projected data visually distinct and preserve missing-data gaps.",
      "**Do** size cards to content and use their container width to adapt dense readings.",
      "**Do** use inline SVG icons, visible focus, and textual status explanations."
    ],
    "donts": [
      "**Don't** turn demo readings, theme samples, or page composition into mandatory host-dashboard values.",
      "**Don't** equate missing telemetry with zero or draw unsupported activity and savings.",
      "**Don't** introduce battery-control affordances into this display-only card collection.",
      "**Don't** hide available chart rows to obtain a shorter mobile card."
    ],
    "overview": "Compact energy instruments belong inside the user's Home Assistant dashboard. The approved world uses native Home Assistant typography, restrained light and dark surfaces, thin dividers, and colored SVG energy plots. Density comes from aligned information and short labels, with content determining card height.\n\nThe system makes present readings, measured history, projections, and unavailable information distinguishable. Theme inheritance is part of the identity: the demo's explicit light and dark palettes demonstrate the cards, but do not replace the host theme contract.",
    "northStar": "EMHASS Companion card language",
    "keyCharacteristics": [
      "Theme-native surfaces and typography.",
      "Stable energy colors across plots and flow nodes.",
      "Compact readings with tabular numerals.",
      "Flat, content-sized cards with inspection on demand."
    ],
    "rules": [
      {
        "name": "The Energy Identity Rule",
        "section": "colors",
        "body": "Keep each energy role's color consistent across charts, activity rows, and live flow nodes."
      },
      {
        "name": "The Host Theme Rule",
        "section": "colors",
        "body": "Resolve host theme variables before fallback values; do not freeze the demo palette into cards."
      },
      {
        "name": "The Reading Alignment Rule",
        "section": "typography",
        "body": "Use tabular numerals and baseline alignment for comparable readings, retaining the unit beside its value."
      },
      {
        "name": "The Flat Instrument Rule",
        "section": "elevation",
        "body": "Use borders and tonal separation for card structure; keep readings and charts visually in the foreground."
      }
    ]
  }
}
