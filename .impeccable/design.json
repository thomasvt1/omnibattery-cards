      "description": "Theme-native, flat, content-sized card shell.",
      "html": "<section class=\"ds-card\"><h2>Overview</h2><p>Live power</p></section>",
      "css": ".ds-card{font-family:var(--ha-font-family-body,var(--paper-font-body1_-_font-family,Roboto,Arial,sans-serif));font-size:14px;line-height:1.45;color:var(--primary-text-color,#202530);padding:20px;border:var(--ha-card-border-width,1px) solid var(--ha-card-border-color,var(--divider-color,#e2e5eb));border-radius:var(--ha-card-border-radius,12px);background:var(--ha-card-background,var(--card-background-color,#fff));box-shadow:none;overflow:hidden}.ds-card h2{margin:0;font-size:18px;line-height:1.3;font-weight:600;letter-spacing:-.2px;overflow-wrap:anywhere}.ds-card p{color:var(--secondary-text-color,#687080);font-size:12px}@media(max-width:450px){.ds-card{padding:16px}.ds-card h2{font-size:17px}}"
    },
