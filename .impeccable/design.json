      "html": "<label class=\"ds-field\"><span>Title</span><input placeholder=\"Default card title\"></label>",
      "css": ".ds-field{display:grid;gap:7px;font-size:14px;min-width:0;color:var(--primary-text-color,#202523);font-family:var(--paper-font-body1_-_font-family,inherit)}.ds-field>span{font-weight:500}.ds-field input{box-sizing:border-box;width:100%;min-height:44px;min-width:0;border:1px solid var(--divider-color,#d4dcd6);border-radius:8px;padding:10px 12px;color:var(--primary-text-color,#202523);background:var(--card-background-color,#fff);font:inherit}.ds-field input:focus-visible{outline:2px solid var(--primary-color,#327965);outline-offset:2px}"
